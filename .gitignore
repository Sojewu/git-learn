# 注释行

# 忽略特定文件
secret.txt
debug.log

# 忽略整个目录（末尾加斜杠）
node_modules/
temp/

# 使用通配符
*.tmp          # 忽略所有 .tmp 文件
build_*.exe    # 忽略 build_a.exe, build_b.exe 等
*.exe          # 忽略所有 .exe 文件 
*.o            # 忽略所有 .o 文件

# 忽略特定路径下的文件（相对仓库根目录）

# 取反（不忽略某个已被忽略的规则）
*.log
!important.log   # 不忽略 important.log 文件